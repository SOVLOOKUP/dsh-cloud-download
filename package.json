{
  "name": "dsh-cloud-download",
  "version": "1.2.0",
  "description": "Download delivered, changed, and previewed files from the DSH Web GUI, and hide native open controls that cannot work in headless or remote deployments.",
  "type": "module",
  "license": "MIT",
  "author": "SOVLOOKUP",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "download",
    "deliverables",
    "review",
    "preview",
    "headless",
    "cloud"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOVLOOKUP/dsh-cloud-download.git"
  },
  "homepage": "https://github.com/SOVLOOKUP/dsh-cloud-download#readme",
  "bugs": {
    "url": "https://github.com/SOVLOOKUP/dsh-cloud-download/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && npm run build && tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "index.js",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "assets",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-deliverables"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
